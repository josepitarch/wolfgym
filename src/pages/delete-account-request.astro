---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout 
  title="Solicitud de Eliminación de Cuenta | WolfGym" 
  description="Solicita la eliminación de tu cuenta y todos tus datos personales en WolfGym."
>
  <div class="min-h-screen bg-black text-white flex flex-col items-center justify-center px-4 py-16">
    <div class="max-w-2xl w-full text-center">
      <img 
        src="/logo-without-bg.png" 
        alt="WolfGym Logo" 
        class="w-32 h-32 mx-auto mb-8"
      />
      
      <h1 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-br from-white to-gray-300 bg-clip-text text-transparent">Solicitud de Eliminación de Cuenta</h1>
      
      <p class="text-lg mb-6 leading-relaxed text-gray-300">
        Para solicitar la eliminación de tu cuenta y todos tus datos, introduce tu email a continuación.
      </p>
      
      <form action="https://api.ctrlgym.es/delete-account-request" method="POST" class="mb-8">
        <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
          <input 
            type="email" 
            name="email" 
            placeholder="tu@email.com" 
            required
            class="w-full md:w-96 px-6 py-3 rounded-full bg-gray-900 text-white border border-gray-700 focus:border-white focus:outline-none transition"
          />
          <button 
            type="submit" 
            class="w-full md:w-auto bg-white text-black font-semibold px-8 py-3 rounded-full hover:bg-gray-200 transition"
          >
            Enviar Solicitud
          </button>
        </div>
      </form>
      
      <p class="text-gray-400 text-sm mb-8">
        Si tienes alguna duda o necesitas ayuda adicional, no dudes en contactarnos en&nbsp;<a href="mailto:info@wolfgyms.es" class="text-white hover:underline">info@wolfgyms.es</a>
      </p>
      
      <a href="/" class="inline-block bg-gray-800 text-white font-semibold px-8 py-3 rounded-full hover:bg-gray-700 transition">
        Volver al Inicio
      </a>
    </div>
  </div>
</BaseLayout>
