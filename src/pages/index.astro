---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Typewriter from "@/components/Typewriter.tsx";
---

<BaseLayout title="WolfGym - Gimnasio de Barrio">
  <div class="min-h-screen bg-black text-white">
    {/* Hero Section with Video */}
    <section class="relative h-screen flex items-center justify-center overflow-hidden">
      <video 
        class="absolute top-0 left-0 w-full h-full object-cover z-0"
        autoplay 
        muted 
        loop 
        playsinline
      >
        <source src="/WolfGym4.mp4" type="video/mp4" />
      </video>
      <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-black/30 to-black/80 z-10"></div>
      <div class="relative z-20 text-center px-4">
        <img 
          src="/logo-without-bg.png" 
          alt="WolfGym Logo" 
          class="w-32 h-auto mx-auto mb-4 drop-shadow-[0_4px_20px_rgba(192,192,192,0.3)]"
        />
        <h1 class="text-6xl md:text-8xl font-black tracking-tight bg-gradient-to-br from-white to-gray-300 bg-clip-text text-transparent">
          WOLFGYM
        </h1>
        <div class="mt-6 h-8">
          <Typewriter client:load />
        </div>
      </div>
    </section>

    {/* Pricing Section */}
    <section class="py-24 px-4 bg-black">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16">
          <p class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Membresías</p>
          <h2 class="text-5xl md:text-6xl font-black tracking-tight">Precios</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
          {/* Mensual */}
          <div class="bg-[#0a0a0a] border border-[#1a1a1a] p-8 transition-all duration-300 hover:bg-[#111111] hover:border-gray-300">
            <div class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Mensual</div>
            <div class="text-6xl font-black mb-6 tracking-tight">40€<span class="text-base text-gray-500 font-normal tracking-normal">/mes</span></div>
            <ul class="space-y-3 mb-8">
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Acceso ilimitado</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Todas las instalaciones</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Sin permanencia</li>
            </ul>
            <a href="#" class="block w-full bg-transparent text-white px-6 py-4 font-semibold uppercase tracking-wider text-sm border border-[#333] transition-all duration-300 hover:bg-gray-300 hover:text-black hover:border-gray-300 text-center no-underline">
              Empezar
            </a>
          </div>

          {/* Trimestral */}
          <div class="bg-[#0a0a0a] border border-[#1a1a1a] p-8 transition-all duration-300 hover:bg-[#111111] hover:border-gray-300">
            <div class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Trimestral</div>
            <div class="text-6xl font-black mb-6 tracking-tight">109€<span class="text-base text-gray-500 font-normal tracking-normal">/3 meses</span></div>
            <ul class="space-y-3 mb-8">
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Acceso ilimitado</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Todas las instalaciones</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Ahorras 11€</li>
            </ul>
            <a href="#" class="block w-full bg-transparent text-white px-6 py-4 font-semibold uppercase tracking-wider text-sm border border-[#333] transition-all duration-300 hover:bg-gray-300 hover:text-black hover:border-gray-300 text-center no-underline">
              Empezar
            </a>
          </div>

          {/* Semestral - Featured */}
          <div class="bg-[#111111] border border-gray-300 p-8 transition-all duration-300 relative">
            <div class="absolute top-4 right-4 bg-gray-300 text-black px-3 py-1 text-xs font-bold uppercase tracking-wider">Popular</div>
            <div class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Semestral</div>
            <div class="text-6xl font-black mb-6 tracking-tight">189€<span class="text-base text-gray-500 font-normal tracking-normal">/6 meses</span></div>
            <ul class="space-y-3 mb-8">
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Acceso ilimitado</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Todas las instalaciones</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Ahorras 51€</li>
            </ul>
            <a href="#" class="block w-full bg-gray-300 text-black px-6 py-4 font-semibold uppercase tracking-wider text-sm transition-all duration-300 hover:bg-white text-center no-underline">
              Empezar
            </a>
          </div>

          {/* Anual */}
          <div class="bg-[#0a0a0a] border border-[#1a1a1a] p-8 transition-all duration-300 hover:bg-[#111111] hover:border-gray-300">
            <div class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Anual</div>
            <div class="text-6xl font-black mb-6 tracking-tight">379€<span class="text-base text-gray-500 font-normal tracking-normal">/año</span></div>
            <ul class="space-y-3 mb-8">
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Acceso ilimitado</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Todas las instalaciones</li>
              <li class="text-gray-300 pb-3 border-b border-[#1a1a1a]">Ahorras 101€</li>
            </ul>
            <a href="#" class="block w-full bg-transparent text-white px-6 py-4 font-semibold uppercase tracking-wider text-sm border border-[#333] transition-all duration-300 hover:bg-gray-300 hover:text-black hover:border-gray-300 text-center no-underline">
              Empezar
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Schedule Section */}
    <section class="py-24 px-4 bg-[#0a0a0a]">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16">
          <p class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Cuándo venir</p>
          <h2 class="text-5xl md:text-6xl font-black tracking-tight">Horario</h2>
        </div>
        
        <div class="py-8">
          <div class="text-4xl md:text-5xl font-black tracking-tight">05:00 - 02:00</div>
        </div>
        
        <p class="mt-12 pt-8 border-t border-[#1a1a1a] text-gray-500 text-sm">
          Abierto los 365 días del año. El horario puede variar en festivos.
        </p>
      </div>
    </section>

    {/* Location Section */}
    <section class="py-24 px-4 bg-black">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16">
          <p class="text-sm text-gray-400 uppercase tracking-[0.2em] mb-4 font-semibold">Encuéntranos</p>
          <h2 class="text-5xl md:text-6xl font-black tracking-tight">Ubicación</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div>
            <h3 class="text-2xl font-bold mb-4">Visítanos</h3>
            <p class="text-xl text-gray-300 leading-relaxed mb-8">
              Calle Principal, 123<br />
              Tu Ciudad, CP 12345
            </p>
            <a 
              href="https://maps.google.com" 
              target="_blank"
              class="inline-flex items-center gap-2 bg-gray-300 text-black px-8 py-4 font-semibold uppercase tracking-wider text-sm transition-all duration-300 hover:bg-white hover:translate-x-1 no-underline"
            >
              Ver en Google Maps →
            </a>
          </div>
          <div class="bg-[#0a0a0a] border border-[#1a1a1a] aspect-[4/3] flex items-center justify-center text-gray-500 text-sm">
            [Mapa de Google Maps]
          </div>
        </div>
      </div>
    </section>

    {/* Footer */}
    <footer class="bg-black text-center py-12 px-4 border-t border-[#1a1a1a]">
      <p class="text-gray-500 text-sm">
        &copy; 2024 WolfGym. Todos los derechos reservados.
      </p>
    </footer>
  </div>
</BaseLayout>
