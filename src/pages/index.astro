---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import PricingSection from "@/components/sections/PricingSection.astro";
import ScheduleSection from "@/components/sections/ScheduleSection.astro";
import AppSection from "@/components/sections/AppSection.astro";
import LocationSection from "@/components/sections/LocationSection.astro";
import Footer from "@/components/sections/Footer.astro";
---

<BaseLayout
  title="WolfGym | Gimnasio en Vila-real, Castellón | Tu Gym de Barrio"
  description="WolfGym: el gimnasio de barrio en Vila-real (Castellón). Entrena sin permanencia desde 40€/mes. Instalaciones completas, ambiente cercano y horarios flexibles. ¡Ven a conocernos!"
  keywords="gimnasio vilarreal, gimnasio vila-real, gimnasio castellon, gym vilarreal, wolf gym, gimnasio zona castellon, fitness vilarreal, gimnasio barrio castellon, gimnasio 12540, gimnasio avda francesc tarrega"
/>
  <div class="min-h-screen bg-black text-white">
    <HeroSection />
    <PricingSection />
    <ScheduleSection />
    <AppSection />
    <LocationSection />
    <Footer />
  </div>
</BaseLayout>
